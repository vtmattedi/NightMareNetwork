#pragma once

#include <NightMare/HardwareProfile.h>

// Copy to the consuming project's include/NightMareHardware.h.
namespace NMHardware
{
inline Profile projectProfile()
{
    static const Connection connections[] = {
        {"user button", 9, Direction::Input, Pull::Up, true, "example GPIO"},
        {"status LED", 7, Direction::Output, Pull::None, true, "example GPIO"},
    };
    return {"Project ESP32 board", connections,
            sizeof(connections) / sizeof(connections[0])};
}
}
