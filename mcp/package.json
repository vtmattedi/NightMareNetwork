{
  "name": "nightmare-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing NightMare Network documentation, source and examples to AI assistants.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/http.js",
    "stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
