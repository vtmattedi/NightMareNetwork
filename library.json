{
  "name": "NightMareNetwork",
  "version": "1.0.0-alpha.1",
  "frameworks": ["arduino", "espidf"],
  "platforms": ["espressif32"],
  "dependencies": [
    {"owner": "bblanchon", "name": "ArduinoJson", "version": "^7.0.0"}
  ],
  "export": {"exclude": ["Legacy/**", "FailedAttempt/**", "new/**", "tests/**"]},
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "libLDFMode": "chain+",
    "flags": "-I$PROJECT_DIR/include"
  }
}
